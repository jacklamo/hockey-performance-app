# Copy this file to .env and fill in your value.
# DATABASE_URL_UNPOOLED must be the direct (non-pooled) Neon connection string.
# Get it from: Neon Dashboard → your project → Connection Details → Direct connection
DATABASE_URL_UNPOOLED=postgresql://user:pass@ep-xxxx.us-east-2.aws.neon.tech/dbname?sslmode=require&channel_binding=require
